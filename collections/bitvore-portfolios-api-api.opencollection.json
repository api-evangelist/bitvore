{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bitvore Portfolios API API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Portfolios API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Portfolios",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bitvore.com/v2/corp/portfolios"
          },
          "docs": "Returns all portfolios for a user."
        },
        {
          "info": {
            "name": "Add Portfolio",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bitvore.com/v2/corp/portfolios",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new portfolio"
        },
        {
          "info": {
            "name": "Get Portfolio",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ]
          },
          "docs": "Returns a portfolio by Id. Items can be optionally returned."
        },
        {
          "info": {
            "name": "Update Portfolio",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Changes the portfolio with the given Id, the result of the changes are returned as a portfolio"
        },
        {
          "info": {
            "name": "Delete Portfolio",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ]
          },
          "docs": "Deletes the portfolio with the given Id"
        },
        {
          "info": {
            "name": "Upload Portfolio Items",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/itemUploads",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "replaceItems",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads a CSV file of portfolio items. The Id Scheme column must exist in the header; CUSIP for Muni API and BVID for Corp API"
        },
        {
          "info": {
            "name": "Return Portfolio Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/items",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ]
          },
          "docs": "Returns the items in the portfolio with the given Id"
        },
        {
          "info": {
            "name": "Add Portfolio Item",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/items",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds items to the portfolio with the given Id, the added items are returned"
        },
        {
          "info": {
            "name": "Replace Portfolio Items",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/items",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replaces the items in the portfolio with the given Id, the added items are returned"
        },
        {
          "info": {
            "name": "Delete Portfolio Items",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/items",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Id of item(s) to remove"
              }
            ]
          },
          "docs": "Deletes the specified items in the portfolio with the given Id. If ids is null, all items will be deleted."
        },
        {
          "info": {
            "name": "Return Portfolio Ids",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/items/ids",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ]
          },
          "docs": "Returns the ids in the portfolio"
        },
        {
          "info": {
            "name": "Add Portfolio items by Ids",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/items/ids",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds items to the portfolio with the given Ids, the added items are returned. Adding by id will override existing customId mappings for that id."
        },
        {
          "info": {
            "name": "Replace Portfolio Items",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/items/ids",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replaces the items in the portfolio with the given Id, the added items are returned. Replacing by id will override existing customId mappings for that id."
        },
        {
          "info": {
            "name": "Delete Portfolio Item",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bitvore.com/v2/corp/portfolios/:portfolioId/items/:id",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Portfolio Id"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of item to remove"
              }
            ]
          },
          "docs": "Deletes the specified item in the portfolio with the given Id"
        },
