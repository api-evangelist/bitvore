              "body": "{\n  \"count\": 1,\n  \"reason\": \"Could not locate subject.\",\n  \"reasonSupport\": \"Longer description of the missing subject.\",\n  \"response\": [\n    {\n      \"recordType\": \"WEBCONTENT\",\n      \"availableAt\": \"2017-06-29T21:41:21.109Z\",\n      \"body\": \"ACME announces long awaited acquisition. The acquisition of Wile E. Coyote was announced Thursday. ACME literally paid peanuts.\",\n      \"cities\": [\n        \"string\",\n        \"string\"\n      ],\n      \"collectedAt\": \"2017-06-29T21:41:21.109Z\",\n      \"collectedSourceUrl\": \"http:/aggregator.com?id=11\",\n      \"counties\": [\n        \"string\",\n        \"string\"\n      ],\n      \"cusips\": [\n        \"string\",\n        \"string\"\n      ],\n      \"description\": \"ACME announces long awaited acquisition. To continue reading this document, click here for the original version.\",\n      \"key\": \"070000015cf083aba01f0826ecfe718e965b577c572166b14a77651c\",\n      \"previewImageUrl\": \"http://acme.com/resources/coyote.jpg\",\n      \"publishedAt\": \"2017-06-29T21:41:21.109Z\",\n      \"referencedOrgs\": [\n        {\n          \"bvId\": \"b00001ab7\",\n          \"name\": \"ACME Corp\"\n        },\n        {\n          \"bvId\": \"b00001ab7\",\n          \"name\": \"ACME Corp\"\n        }\n      ],\n      \"sectors\": [\n        \"string\",\n        \"string\"\n      ],\n      \"signals\": [\n        \"string\",\n        \"string\"\n      ],\n      \"significance\": \"HIGH\",\n      \"sourceUrl\": \"http://acme.com/press\",\n      \"states\": [\n        \"string\",\n        \"string\"\n      ],\n      \"title\": \"ACME aquires Wile E. Coyote\"\n    },\n    {\n      \"recordType\": \"WEBCONTENT\",\n      \"availableAt\": \"2017-06-29T21:41:21.109Z\",\n      \"body\": \"ACME announces long awaited acquisition. The acquisition of Wile E. Coyote was announced Thursday. ACME literally paid peanuts.\",\n      \"cities\": [\n        \"string\",\n        \"string\"\n      ],\n      \"collectedAt\": \"2017-06-29T21:41:21.109Z\",\n      \"collectedSourceUrl\": \"http:/aggregator.com?id=11\",\n      \"counties\": [\n        \"string\",\n        \"string\"\n      ],\n      \"cusips\": [\n        \"string\",\n        \"string\"\n      ],\n      \"description\": \"ACME announces long awaited acquisition. To continue reading this document, click here for the original version.\",\n      \"key\": \"070000015cf083aba01f0826ecfe718e965b577c572166b14a77651c\",\n      \"previewImageUrl\": \"http://acme.com/resources/coyote.jpg\",\n      \"publishedAt\": \"2017-06-29T21:41:21.109Z\",\n      \"referencedOrgs\": [\n        {\n          \"bvId\": \"b00001ab7\",\n          \"name\": \"ACME Corp\"\n        },\n        {\n          \"bvId\": \"b00001ab7\",\n          \"name\": \"ACME Corp\"\n        }\n      ],\n      \"sectors\": [\n        \"string\",\n        \"string\"\n      ],\n      \"signals\": [\n        \"string\",\n        \"string\"\n      ],\n      \"significance\": \"HIGH\",\n      \"sourceUrl\": \"http://acme.com/press\",\n      \"states\": [\n        \"string\",\n        \"string\"\n      ],\n      \"title\": \"ACME aquires Wile E. Coyote\"\n    }\n  ],\n  \"success\": true\n}",
